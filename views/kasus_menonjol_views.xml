<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="view_petadigi_kasus_menonjol_list" model="ir.ui.view">
            <field name="name">kasus_menonjol.list.petadigi</field>
            <field name="model">petadigi.kasus_menonjol</field>
            <field name="arch" type="xml">
                <list string="Kasus Menonjol">
                    <field name="has_tindak_lanjut" column_invisible="1"/>
                    <field name="code"/>
                    <field name="no_lp" optional="hide"/>
                    <field name="tahun"/>
                    <field name="kategori_id"/>
                    <field name="jenis_tkp_id"/>
                    <field name="tanggal_kejadian"/>
                    <field name="polres_id"/>
                    <field name="polsek_id" optional="hide"/>
                    <field name="kabupaten_id"/>
                    <field name="kecamatan_id" optional="hide"/>
                    <field name="desa_id" optional="hide"/>
                    <field name="subdit_id"/>
                    <field name="state" widget="badge"
                        decoration-info="has_tindak_lanjut"
                        decoration-success="state == 'SELESAI' and not has_tindak_lanjut"
                        decoration-warning="state == 'PROSES' and not has_tindak_lanjut"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_petadigi_kasus_menonjol_search" model="ir.ui.view">
            <field name="name">kasus_menonjol.search.petadigi</field>
            <field name="model">petadigi.kasus_menonjol</field>
            <field name="arch" type="xml">
                <search string="Cari Kasus Menonjol">
                    <field name="code"/>
                    <field name="no_lp"/>
                    <field name="tersangka"/>
                    <field name="permasalahan"/>
                    <field name="penanganan"/>
                    <field name="kategori_id"/>
                    <field name="polres_id"/>
                    <field name="kabupaten_id"/>
                    <separator/>
                    <filter string="Status PROSES" name="filter_status_proses" domain="[('state','=','PROSES')]"/>
                    <filter string="Status SELESAI" name="filter_status_selesai" domain="[('state','=','SELESAI')]"/>
                    <filter string="Ada Tindak Lanjut" name="filter_ada_tindak_lanjut" domain="[('has_tindak_lanjut','=',True)]"/>
                    <separator/>
                    <filter string="Tahun Ini" name="filter_tahun_sekarang"
                        domain="[('tahun', '=', context_today().year)]"/>
                    <filter string="2026" name="filter_tahun_2026" domain="[('tahun', '=', '2026')]"/>
                    <filter string="2025" name="filter_tahun_2025" domain="[('tahun', '=', '2025')]"/>
                    <filter string="2024" name="filter_tahun_2024" domain="[('tahun', '=', '2024')]"/>
                    <filter string="2023" name="filter_tahun_2023" domain="[('tahun', '=', '2023')]"/>
                    <filter string="Tanggal Kejadian" name="filter_tanggal_kejadian" date="tanggal_kejadian"/>
                    <group>
                        <filter string="Tahun" name="groupby_tahun" context="{'group_by': 'tahun'}"/>
                        <filter string="Kategori" name="groupby_kategori" context="{'group_by': 'kategori_id'}"/>
                        <filter string="Modus Operandi" name="groupby_modus" context="{'group_by': 'modus_operandi_id'}"/>
                        <filter string="Jenis TKP" name="groupby_jenis_tkp" context="{'group_by': 'jenis_tkp_id'}"/>
                        <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                        <filter string="Tujuan" name="groupby_tujuan" context="{'group_by': 'subdit_id'}"/>
                        <filter string="Polres" name="groupby_polres" context="{'group_by': 'polres_id'}"/>
                        <filter string="Polsek" name="groupby_polsek" context="{'group_by': 'polsek_id'}"/>
                        <filter string="Kabupaten" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- GRAPH VIEW -->
        <record id="view_petadigi_kasus_menonjol_graph" model="ir.ui.view">
            <field name="name">kasus_menonjol.graph.petadigi</field>
            <field name="model">petadigi.kasus_menonjol</field>
            <field name="arch" type="xml">
                <graph string="Grafik Kasus Menonjol" type="bar">
                    <field name="tanggal_kejadian" interval="month"/>
                    <field name="kategori_id"/>
                    <field name="state"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- PIVOT VIEW -->
        <record id="view_petadigi_kasus_menonjol_pivot" model="ir.ui.view">
            <field name="name">kasus_menonjol.pivot.petadigi</field>
            <field name="model">petadigi.kasus_menonjol</field>
            <field name="arch" type="xml">
                <pivot string="Analisis Kasus Menonjol" disable_linking="False">
                    <field name="kategori_id" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- CALENDAR VIEW -->
        <record id="view_petadigi_kasus_menonjol_calendar" model="ir.ui.view">
            <field name="name">kasus_menonjol.calendar.petadigi</field>
            <field name="model">petadigi.kasus_menonjol</field>
            <field name="arch" type="xml">
                <calendar string="Kalender Kasus Menonjol"
                          date_start="tanggal_kejadian"
                          color="state"
                          mode="month"
                          quick_create="False">
                    <field name="no_lp"/>
                    <field name="kategori_id"/>
                    <field name="kabupaten_id"/>
                    <field name="state" filters="1" invisible="1"/>
                </calendar>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_petadigi_kasus_menonjol_form" model="ir.ui.view">
            <field name="name">kasus_menonjol.form.petadigi</field>
            <field name="model">petadigi.kasus_menonjol</field>
            <field name="arch" type="xml">
                <form string="Kasus Menonjol">
                    <header>
                        <button name="action_set_selesai" string="Selesai" type="object"
                            class="btn-primary" invisible="state == 'SELESAI'"/>
                        <button name="action_set_proses" string="Kembalikan ke Proses" type="object"
                            class="btn-secondary" invisible="state == 'PROSES'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="PROSES,SELESAI"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="code" readonly="1"/></h1>
                        </div>
                        <group>
                            <field name="no_lp"/>
                            <field name="subdit_id"/>
                            <field name="sumber_dokumen_id"/>
                        </group>
                        <group>
                            <group string="KESATUAN">
                                <!-- Admin / Subdit: bebas pilih -->
                                <field name="polres_id"
                                    groups="petadigi.group_admin,petadigi.group_subdit"/>
                                <field name="polsek_id"
                                    groups="petadigi.group_admin,petadigi.group_subdit"
                                    domain="[('polres_id', '=', polres_id)]"/>
                                <!-- Polres: polres terkunci, polsek bisa dipilih dari polres-nya -->
                                <field name="polres_id"
                                    groups="petadigi.group_polres"
                                    readonly="1"/>
                                <field name="polsek_id"
                                    groups="petadigi.group_polres"
                                    domain="[('polres_id', '=', polres_id)]"/>
                                <!-- Polsek: keduanya terkunci -->
                                <field name="polres_id"
                                    groups="petadigi.group_polsek"
                                    readonly="1"/>
                                <field name="polsek_id"
                                    groups="petadigi.group_polsek"
                                    readonly="1"/>
                            </group>
                            <group string="KATEGORI">
                                <field name="kategori_id"/>
                                <field name="modus_operandi_id"/>
                                <field name="jenis_tkp_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="WILAYAH">
                                <!-- Admin / Subdit / Polres: kabupaten editable (record rule filter polres) -->
                                <field name="kabupaten_id"
                                    groups="petadigi.group_admin,petadigi.group_subdit,petadigi.group_polres"/>
                                <field name="kecamatan_id"
                                    groups="petadigi.group_admin,petadigi.group_subdit,petadigi.group_polres"
                                    domain="[('kabupaten_id', '=', kabupaten_id)]"/>
                                <field name="desa_id"
                                    groups="petadigi.group_admin,petadigi.group_subdit,petadigi.group_polres"
                                    domain="[('kecamatan_id', '=', kecamatan_id)]"/>
                                <!-- Polsek: kabupaten readonly, kecamatan tanpa domain (record rule sudah filter) -->
                                <field name="kabupaten_id"
                                    groups="petadigi.group_polsek"
                                    readonly="1"/>
                                <field name="kecamatan_id"
                                    groups="petadigi.group_polsek"/>
                                <field name="desa_id"
                                    groups="petadigi.group_polsek"
                                    domain="[('kecamatan_id', '=', kecamatan_id)]"/>
                            </group>
                            <group string="STATUS">
                                <field name="tanggal_kejadian"/>
                            </group>
                        </group>

                        <div>
                            <field name="latitude" widget="latlong_map_picker"
                                class="latlong-mappicker-wrapper"
                                nolabel="1"/>
                        </div>

                        <group>
                            <field name="latitude" string="Latitude"/>
                            <field name="longitude" string="Longitude"/>
                        </group>

                        <notebook>
                            <page string="Detail Kasus">
                                <group>
                                    <field name="tersangka"/>
                                    <field name="permasalahan"/>
                                    <field name="penanganan"/>
                                    <field name="tindak_lanjut"/>
                                </group>
                            </page>
                            <page string="Tindak Lanjut" name="tindak_lanjut_tab">
                                <div class="mb-2">
                                    <button name="action_open_tindak_lanjut_wizard"
                                        string="Tambah Tindak Lanjut" type="object"
                                        class="btn-primary" icon="fa-plus"/>
                                </div>
                                <field name="tindak_lanjut_ids" nolabel="1">
                                    <list default_order="tanggal desc" no_open="1">
                                        <field name="tanggal"/>
                                        <field name="tindakan"/>
                                        <field name="attachment" widget="binary"
                                            filename="attachment_filename"
                                            string="Lampiran" readonly="1"/>
                                        <field name="attachment_filename" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_petadigi_kasus_menonjol" model="ir.actions.act_window">
            <field name="name">Kasus Menonjol</field>
            <field name="res_model">petadigi.kasus_menonjol</field>
            <field name="view_mode">list,form,graph,pivot,calendar</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list',     'view_id': ref('view_petadigi_kasus_menonjol_list')}),
                (0, 0, {'view_mode': 'form',     'view_id': ref('view_petadigi_kasus_menonjol_form')}),
                (0, 0, {'view_mode': 'graph',    'view_id': ref('view_petadigi_kasus_menonjol_graph')}),
                (0, 0, {'view_mode': 'pivot',    'view_id': ref('view_petadigi_kasus_menonjol_pivot')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_petadigi_kasus_menonjol_calendar')}),
            ]"/>
            <field name="search_view_id" ref="petadigi.view_petadigi_kasus_menonjol_search"/>
            <field name="context">{'search_default_filter_tahun_sekarang': 1}</field>
        </record>
    </data>
</odoo>
