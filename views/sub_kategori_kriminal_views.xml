<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_petadigi_sub_kategori_kriminal_list" model="ir.ui.view">
            <field name="name">sub_kategori_kriminal.list.petadigi</field>
            <field name="model">petadigi.sub_kategori_kriminal</field>
            <field name="arch" type="xml">
                <list string="Sub Kategori Kriminal">
                    <field name="name"/>
                    <field name="kategori_kriminal_id"/>
                    <field name="kriminalitas_proses" string="Proses" optional="show"/>
                    <field name="kriminalitas_selesai" string="Selesai" optional="show"/>
                    <field name="keterangan" optional="show"/>
                </list>
            </field>
        </record>
        <record id="view_petadigi_sub_kategori_kriminal_form" model="ir.ui.view">
            <field name="name">sub_kategori_kriminal.form.petadigi</field>
            <field name="model">petadigi.sub_kategori_kriminal</field>
            <field name="arch" type="xml">
                <form string="Sub Kategori Kriminal">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_view_kriminalitas_proses" icon="fa-spinner">
                                <field name="kriminalitas_proses" widget="statinfo" string="Proses"/>
                            </button>
                            <button class="oe_stat_button" type="object"
                                    name="action_view_kriminalitas_selesai" icon="fa-check-circle">
                                <field name="kriminalitas_selesai" widget="statinfo" string="Selesai"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="kategori_kriminal_id"/>
                            <field name="keterangan"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_petadigi_sub_kategori_kriminal" model="ir.actions.act_window">
            <field name="name">Sub Kategori Kriminal</field>
            <field name="res_model">petadigi.sub_kategori_kriminal</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>