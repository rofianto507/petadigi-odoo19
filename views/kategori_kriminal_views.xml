<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_petadigi_kategori_kriminal_list" model="ir.ui.view">
            <field name="name">kategori_kriminal.list.petadigi</field>
            <field name="model">petadigi.kategori_kriminal</field>
            <field name="arch" type="xml">
                <list string="Kategori Kriminal">
                    <field name="icon_preview" widget="html" string="Icon" nolabel="1"/>
                    <field name="name"/>
                    <field name="kriminalitas_proses" string="Proses" optional="show"/>
                    <field name="kriminalitas_selesai" string="Selesai" optional="show"/>
                    <field name="icon" optional="show"/>
                    <field name="keterangan" optional="show"/>
                </list>
            </field>
        </record>
        <record id="view_petadigi_kategori_kriminal_form" model="ir.ui.view">
            <field name="name">kategori_kriminal.form.petadigi</field>
            <field name="model">petadigi.kategori_kriminal</field>
            <field name="arch" type="xml">
                <form string="Kategori Kriminal">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_view_kriminalitas_proses" icon="fa-spinner">
                                <field name="kriminalitas_proses" widget="statinfo" string="Proses"/>
                            </button>
                            <button class="oe_stat_button" type="object"
                                    name="action_view_kriminalitas_selesai" icon="fa-check-circle">
                                <field name="kriminalitas_selesai" widget="statinfo" string="Selesai"/>
                            </button>
                        </div>
                        <group>
                            <group string="Informasi">
                                <field name="name"/>
                                <field name="icon"/>
                                <field name="keterangan"/>
                            </group>
                            <group string="Preview Icon Peta">
                                <field name="icon_preview" widget="html" readonly="1" nolabel="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sub Kategori">
                                <field name="sub_kategori_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="keterangan"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_petadigi_kategori_kriminal" model="ir.actions.act_window">
            <field name="name">Kategori Kriminal</field>
            <field name="res_model">petadigi.kategori_kriminal</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
