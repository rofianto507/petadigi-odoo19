<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="view_kategori_sumur_minyak_list" model="ir.ui.view">
            <field name="name">kategori_sumur_minyak.list.petadigi</field>
            <field name="model">petadigi.kategori_sumur_minyak</field>
            <field name="arch" type="xml">
                <list string="Kategori Sumur Minyak">
                    <field name="name"/>
                    <field name="keterangan"/>
                    <field name="total_minyak_produksi" string="Total Produksi" optional="hide"/>
                    <field name="total_minyak_keluar"   string="Total Keluar"   optional="hide"/>
                    <field name="total_minyak_masuk"    string="Total Masuk"    optional="hide"/>
                    <field name="total_minyak_tersedia" string="Total Tersedia" optional="hide"/>
                    <field name="total_minyak_ditolak"  string="Total Ditolak"  optional="hide"/>
                    <field name="total_minyak" string="Total Minyak"/>
                    <field name="state" widget="badge"
                        decoration-muted="state == 'draft'"
                        decoration-success="state == 'aktif'"
                        decoration-danger="state == 'non_aktif'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_kategori_sumur_minyak_search" model="ir.ui.view">
            <field name="name">kategori_sumur_minyak.search.petadigi</field>
            <field name="model">petadigi.kategori_sumur_minyak</field>
            <field name="arch" type="xml">
                <search string="Cari Kategori Sumur Minyak">
                    <field name="name"/>
                    <field name="keterangan"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                    <filter string="Aktif" name="filter_aktif" domain="[('state','=','aktif')]"/>
                    <filter string="Non Aktif" name="filter_non_aktif" domain="[('state','=','non_aktif')]"/>
                    <group>
                        <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_kategori_sumur_minyak_form" model="ir.ui.view">
            <field name="name">kategori_sumur_minyak.form.petadigi</field>
            <field name="model">petadigi.kategori_sumur_minyak</field>
            <field name="arch" type="xml">
                <form string="Kategori Sumur Minyak">
                    <header>
                        <button name="action_set_aktif" string="Aktifkan" type="object"
                            class="btn-success"
                            invisible="state == 'aktif'"/>
                        <button name="action_set_non_aktif" string="Non Aktifkan" type="object"
                            class="btn-danger"
                            invisible="state == 'non_aktif'"/>
                        <button name="action_set_draft" string="Set Draft" type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,aktif,non_aktif"/>
                    </header>
                    <sheet>
                        <field name="kode" invisible="1"/>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-tint" invisible="1"
                                    type="object" name="action_view_sumur">
                                <field name="jumlah_sumur" widget="statinfo" string="Total Sumur"/>
                            </button>
                            <!-- Sumur Masyarakat -->
                            <button class="oe_stat_button" icon="fa-arrow-up" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'sumur_masyarakat'">
                                <field name="total_minyak_produksi" widget="statinfo" string="Produksi"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-arrow-down" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'sumur_masyarakat'">
                                <field name="total_minyak_keluar" widget="statinfo" string="Keluar"/>
                            </button>
                            <!-- BKU -->
                            <button class="oe_stat_button" icon="fa-arrow-up" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'bku'">
                                <field name="total_minyak_masuk" widget="statinfo" string="Masuk"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-database" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'bku'">
                                <field name="total_minyak_tersedia" widget="statinfo" string="Tersedia"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-arrow-down" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'bku'">
                                <field name="total_minyak_keluar" widget="statinfo" string="Keluar"/>
                            </button>
                            <!-- K3S -->
                            <button class="oe_stat_button" icon="fa-arrow-up" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'k3s'">
                                <field name="total_minyak_masuk" widget="statinfo" string="Masuk"/>
                            </button>
                            <button class="oe_stat_button" icon="fa-ban" type="object"
                                    name="action_view_sumur"
                                    invisible="kode != 'k3s'">
                                <field name="total_minyak_ditolak" widget="statinfo" string="Ditolak"/>
                            </button>
                            <!-- Fallback jika kode belum diset -->
                            <button class="oe_stat_button" icon="fa-flask" type="object"
                                    name="action_view_sumur"
                                    invisible="kode in ('sumur_masyarakat', 'bku', 'k3s')">
                                <field name="total_minyak" widget="statinfo" string="Total Minyak"/>
                            </button>
                        </div>

                        <!-- URL + QR Section (hanya tampil saat Aktif) -->
                        <div class="row mb-3 p-3 rounded"
                             invisible="state != 'aktif'"
                             style="background:#fff8f0; border:1.5px solid #f6c06e;">
                            <!-- Kiri: URL + Tombol -->
                            <div class="col-lg-8 col-12 d-flex flex-column gap-2">
                                <div>
                                    <span class="fw-bold" style="color:#B45309;">
                                        <i class="fa fa-link me-1"/>
                                        URL Form Input Sumur Lapangan
                                    </span>
                                </div>
                                <field name="public_url" widget="CopyClipboardChar"
                                       readonly="1" nolabel="1"/>
                                <div class="d-flex gap-2 flex-wrap mt-1">
                                    <button name="action_regenerate_token" type="object"
                                            string="Buat Ulang URL"
                                            class="btn btn-sm btn-secondary"
                                            icon="fa-refresh"
                                            confirm="URL lama akan langsung tidak berlaku. Lanjutkan buat ulang URL?"
                                            title="Buat token URL baru — link lama tidak berlaku"/>
                                    <button name="action_share_whatsapp" type="object"
                                            string="Share WhatsApp Web"
                                            class="btn btn-sm btn-success"
                                            icon="fa-whatsapp"/>
                                </div>
                            </div>
                            <!-- Kanan: QR Code -->
                            <div class="col-lg-4 col-12 d-flex flex-column align-items-center justify-content-center mt-3 mt-lg-0">
                                <div class="text-muted small mb-1">
                                    <i class="fa fa-qrcode me-1"/>QR Code
                                </div>
                                <field name="qr_code_image" widget="image"
                                       readonly="1" nolabel="1"
                                       options="{'size': [150, 150], 'zoom': False}"/>
                            </div>
                        </div>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="kode"/>
                            </group>
                        </group>
                        <group>
                            <field name="keterangan"/>
                        </group>

                        <notebook>
                            <page string="Data Sumur" name="data_sumur">
                                <field name="sumur_ids" nolabel="1">
                                    <list create="0" edit="0" default_order="name asc">
                                        <field name="code" string="Kode"/>
                                        <field name="name" string="Nama Sumur"/>
                                        <field name="kabupaten_id" string="Kabupaten"/>
                                        <field name="kecamatan_id" string="Kecamatan"/>
                                        <field name="desa_id" string="Desa"/>
                                        <field name="minyak_produksi" string="Produksi"
                                            column_invisible="parent.kode != 'sumur_masyarakat'"/>
                                        <field name="minyak_masuk" string="Masuk"
                                            column_invisible="parent.kode not in ('bku', 'k3s')"/>
                                        <field name="minyak_tersedia" string="Tersedia"
                                            column_invisible="parent.kode != 'bku'"/>
                                        <field name="minyak_keluar" string="Keluar"
                                            column_invisible="parent.kode not in ('sumur_masyarakat', 'bku')"/>
                                        <field name="minyak_ditolak" string="Ditolak"
                                            column_invisible="parent.kode != 'k3s'"/>
                                        <field name="total_minyak" string="Total Minyak"
                                            column_invisible="parent.kode in ('sumur_masyarakat', 'bku', 'k3s')"/>
                                        <field name="state" widget="badge"
                                            decoration-success="state == 'AKTIF'"
                                            decoration-danger="state == 'TIDAK AKTIF'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_petadigi_kategori_sumur_minyak" model="ir.actions.act_window">
            <field name="name">Kategori Sumur Minyak</field>
            <field name="res_model">petadigi.kategori_sumur_minyak</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_kategori_sumur_minyak_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_kategori_sumur_minyak_form')}),
            ]"/>
            <field name="search_view_id" ref="petadigi.view_kategori_sumur_minyak_search"/>
        </record>
    </data>
</odoo>
