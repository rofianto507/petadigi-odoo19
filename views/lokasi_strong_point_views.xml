<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_lokasi_strong_point_list" model="ir.ui.view">
            <field name="name">lokasi_strong_point.list.petadigi</field>
            <field name="model">petadigi.lokasi_strong_point</field>
            <field name="arch" type="xml">
                <list string="Lokasi Strong Point">
                    <field name="code"/>
                    <field name="nama"/>
                    <field name="polres_id"/>
                    <field name="polsek_id"/>
                    <field name="lat" optional="hide"/>
                    <field name="lng" optional="hide"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'aktif'"
                        decoration-danger="state == 'non_aktif'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_lokasi_strong_point_search" model="ir.ui.view">
            <field name="name">lokasi_strong_point.search.petadigi</field>
            <field name="model">petadigi.lokasi_strong_point</field>
            <field name="arch" type="xml">
                <search string="Cari Lokasi Strong Point">
                    <field name="code"/>
                    <field name="nama"/>
                    <field name="polres_id"/>
                    <field name="polsek_id"/>
                    <separator/>
                    <filter string="Aktif" name="filter_aktif" domain="[('state','=','aktif')]"/>
                    <filter string="Non Aktif" name="filter_non_aktif" domain="[('state','=','non_aktif')]"/>
                    <group>
                        <filter string="Polres" name="groupby_polres" context="{'group_by': 'polres_id'}"/>
                        <filter string="Polsek" name="groupby_polsek" context="{'group_by': 'polsek_id'}"/>
                        <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_lokasi_strong_point_form" model="ir.ui.view">
            <field name="name">lokasi_strong_point.form.petadigi</field>
            <field name="model">petadigi.lokasi_strong_point</field>
            <field name="arch" type="xml">
                <form string="Lokasi Strong Point">
                    <header>
                        <field name="state" widget="statusbar"
                            statusbar_visible="aktif,non_aktif"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_strong_point" type="object"
                                    class="oe_stat_button" icon="fa-map-marker">
                                <field name="strong_point_count" widget="statinfo" string="Strong Point"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="code" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Informasi Lokasi">
                                <field name="nama"/>
                                <field name="polres_id"/>
                                <field name="polsek_id"/>
                            </group>
                            <group string="Koordinat">
                                <field name="lat" string="Latitude"/>
                                <field name="lng" string="Longitude"/>
                            </group>
                        </group>
                        <group string="Peta Lokasi">
                            <field name="lat"
                                widget="latlong_map_picker"
                                nolabel="1"
                                colspan="2"/>
                        </group>
                        <group>
                            <field name="keterangan" placeholder="Keterangan lokasi strong point..."/>
                        </group>
                        <group string="Foto">
                            <field name="foto" widget="image" options="{'size': [300, 200]}"
                                nolabel="1" colspan="2"/>
                        </group>
                        <notebook>
                            <page string="Strong Point" name="strong_point">
                                <field name="strong_point_ids" readonly="1">
                                    <list string="Strong Point">
                                        <field name="code"/>
                                        <field name="tanggal_mulai"/>
                                        <field name="tanggal_selesai"/>
                                        <field name="personel_count" string="Total Personel"/>
                                        <field name="state" widget="badge"
                                            decoration-warning="state == 'PROSES'"
                                            decoration-success="state == 'SELESAI'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION WINDOW -->
        <record id="action_petadigi_lokasi_strong_point" model="ir.actions.act_window">
            <field name="name">Lokasi Strong Point</field>
            <field name="res_model">petadigi.lokasi_strong_point</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>
