<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_petadigi_polres_list" model="ir.ui.view">
            <field name="name">polres.list.petadigi</field>
            <field name="model">petadigi.polres</field>
            <field name="arch" type="xml">
                <list string="Polres">
                    <field name="name"/>
                    <field name="address"/>
                    <field name="polsek_count" string="Total Polsek"/>
                    
                </list>
            </field>
        </record>

        <record id="view_petadigi_polres_form" model="ir.ui.view">
            <field name="name">polres.form.petadigi</field>
            <field name="model">petadigi.polres</field>
            <field name="arch" type="xml">
                <form string="Polres">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_polsek"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-building">
                                <field name="polsek_count" widget="statinfo" string="Polsek"/>
                            </button>
                            <button name="action_view_kabupaten"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-map-marker">
                                <field name="kabupaten_count" widget="statinfo" string="Kabupaten"/>
                            </button>
                            <button name="action_view_users"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-users">
                                <field name="user_count" widget="statinfo" string="User Polres"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                        </group>
                        <notebook>
                            <page string="Daftar Polsek">
                                <field name="polsek_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="address"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_petadigi_polres_search" model="ir.ui.view">
            <field name="name">polres.search.petadigi</field>
            <field name="model">petadigi.polres</field>
            <field name="arch" type="xml">
                <search string="Cari Polres">
                    <field name="name" string="Nama Polres"/>
                    <field name="address" string="Alamat"/>
                    <separator/>
                    <filter string="Ada Polsek" name="filter_ada_polsek"
                            domain="[('polsek_count', '&gt;', 0)]"/>
                    <filter string="Ada Kabupaten" name="filter_ada_kabupaten"
                            domain="[('kabupaten_count', '&gt;', 0)]"/>
                </search>
            </field>
        </record>

        <record id="action_petadigi_polres" model="ir.actions.act_window">
            <field name="name">Polres</field>
            <field name="res_model">petadigi.polres</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_petadigi_polres_search"/>
        </record>
        
    </data>
</odoo>