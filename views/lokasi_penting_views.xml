<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="view_petadigi_lokasi_penting_list" model="ir.ui.view">
            <field name="name">lokasi_penting.list.petadigi</field>
            <field name="model">petadigi.lokasi_penting</field>
            <field name="arch" type="xml">
                <list string="Lokasi Penting">
                    <field name="code"/>
                    <field name="nama_lokasi"/>
                    <field name="kategori_id"/>
                    <field name="kabupaten_id"/>
                    <field name="kecamatan_id"/>
                    <field name="hp_kontak"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'AKTIF'"
                        decoration-danger="state == 'NON AKTIF'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_petadigi_lokasi_penting_search" model="ir.ui.view">
            <field name="name">lokasi_penting.search.petadigi</field>
            <field name="model">petadigi.lokasi_penting</field>
            <field name="arch" type="xml">
                <search string="Cari Lokasi Penting">
                    <field name="code"/>
                    <field name="nama_lokasi"/>
                    <field name="alamat_lengkap"/>
                    <field name="hp_kontak"/>
                    <separator/>
                    <filter string="AKTIF" name="filter_aktif" domain="[('state','=','AKTIF')]"/>
                    <filter string="NON AKTIF" name="filter_non_aktif" domain="[('state','=','NON AKTIF')]"/>
                    <group>
                        <filter string="Kategori" name="groupby_kategori" context="{'group_by': 'kategori_id'}"/>
                        <filter string="Kabupaten" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                        <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- GRAPH VIEW -->
        <record id="view_petadigi_lokasi_penting_graph" model="ir.ui.view">
            <field name="name">lokasi_penting.graph.petadigi</field>
            <field name="model">petadigi.lokasi_penting</field>
            <field name="arch" type="xml">
                <graph string="Grafik Lokasi Penting" type="bar">
                    <field name="kategori_id"/>
                    <field name="kabupaten_id"/>
                    <field name="state"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_petadigi_lokasi_penting_form" model="ir.ui.view">
            <field name="name">lokasi_penting.form.petadigi</field>
            <field name="model">petadigi.lokasi_penting</field>
            <field name="arch" type="xml">
                <form string="Lokasi Penting">
                    <header>
                        <button name="action_set_non_aktif" string="Non Aktif" type="object"
                            class="btn-danger" invisible="state == 'NON AKTIF'"/>
                        <button name="action_set_aktif" string="Aktifkan Kembali" type="object"
                            class="btn-secondary" invisible="state == 'AKTIF'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="AKTIF,NON AKTIF"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="code" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="nama_lokasi"/>
                                <field name="kategori_id"/>
                                <field name="alamat_lengkap"/>
                                <field name="hp_kontak"/>
                            </group>
                            <group>
                                <field name="foto" widget="image_popup" nolabel="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="WILAYAH">
                                <field name="kabupaten_id"/>
                                <field name="kecamatan_id" domain="[('kabupaten_id', '=', kabupaten_id)]"/>
                                <field name="desa_id" domain="[('kecamatan_id', '=', kecamatan_id)]"/>
                            </group>
                        </group>

                        <div>
                            <field name="latitude" widget="latlong_map_picker"
                                class="latlong-mappicker-wrapper"
                                nolabel="1"/>
                        </div>

                        <group>
                            <field name="latitude" string="Latitude"/>
                            <field name="longitude" string="Longitude"/>
                        </group>

                        <notebook>
                            <page string="Keterangan">
                                <group >
                                    <field name="keterangan" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- PIVOT VIEW -->
        <record id="view_petadigi_lokasi_penting_pivot" model="ir.ui.view">
            <field name="name">lokasi_penting.pivot.petadigi</field>
            <field name="model">petadigi.lokasi_penting</field>
            <field name="arch" type="xml">
                <pivot string="Analisis Lokasi Penting" disable_linking="False">
                    <field name="kategori_id" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_petadigi_lokasi_penting" model="ir.actions.act_window">
            <field name="name">Lokasi Penting</field>
            <field name="res_model">petadigi.lokasi_penting</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list',  'view_id': ref('view_petadigi_lokasi_penting_list')}),
                (0, 0, {'view_mode': 'form',  'view_id': ref('view_petadigi_lokasi_penting_form')}),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('view_petadigi_lokasi_penting_graph')}),
                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_petadigi_lokasi_penting_pivot')}),
            ]"/>
            <field name="search_view_id" ref="petadigi.view_petadigi_lokasi_penting_search"/>
        </record>
    </data>
</odoo>
