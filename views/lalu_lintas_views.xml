<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="view_petadigi_lalu_lintas_list" model="ir.ui.view">
            <field name="name">lalu_lintas.list.petadigi</field>
            <field name="model">petadigi.lalu_lintas</field>
            <field name="arch" type="xml">
                <list string="Data Lalu Lintas">
                    <field name="code"/>
                    <field name="tahun"/>
                    <field name="nama_lokasi"/>
                    <field name="kategori_id"/>
                    <field name="jenis_jalan_id"/>
                    <field name="tanggal_kejadian"/>
                    <field name="kabupaten_id"/>
                    <field name="kecamatan_id" optional="hide"/>
                    <field name="desa_id" optional="hide"/>
                    <field name="penanggung_jawab" optional="hide"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'SELESAI'"
                        decoration-warning="state == 'PROSES'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_petadigi_lalu_lintas_search" model="ir.ui.view">
            <field name="name">lalu_lintas.search.petadigi</field>
            <field name="model">petadigi.lalu_lintas</field>
            <field name="arch" type="xml">
                <search string="Cari Data Lalu Lintas">
                    <field name="code"/>
                    <field name="nama_lokasi"/>
                    <field name="penanggung_jawab"/>
                    <field name="keterangan"/>
                    <separator/>
                    <filter string="Status PROSES" name="filter_proses" domain="[('state','=','PROSES')]"/>
                    <filter string="Status SELESAI" name="filter_selesai" domain="[('state','=','SELESAI')]"/>
                    <separator/>
                    <filter string="Tahun Ini" name="filter_tahun_sekarang"
                        domain="[('tahun', '=', context_today().year)]"/>
                    <filter string="2025" name="filter_tahun_2025" domain="[('tahun', '=', '2025')]"/>
                    <filter string="2024" name="filter_tahun_2024" domain="[('tahun', '=', '2024')]"/>
                    <filter string="2023" name="filter_tahun_2023" domain="[('tahun', '=', '2023')]"/>
                    <filter string="Tanggal Kejadian" name="filter_tanggal_kejadian" date="tanggal_kejadian"/>
                    <group>
                        <filter string="Tahun" name="groupby_tahun" context="{'group_by': 'tahun'}"/>
                        <filter string="Kategori" name="groupby_kategori" context="{'group_by': 'kategori_id'}"/>
                        <filter string="Jenis Jalan" name="groupby_jenis_jalan" context="{'group_by': 'jenis_jalan_id'}"/>
                        <filter string="Kabupaten" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                        <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- GRAPH VIEW -->
        <record id="view_petadigi_lalu_lintas_graph" model="ir.ui.view">
            <field name="name">lalu_lintas.graph.petadigi</field>
            <field name="model">petadigi.lalu_lintas</field>
            <field name="arch" type="xml">
                <graph string="Grafik Lalu Lintas" type="bar">
                    <field name="kategori_id"/>
                    <field name="jenis_jalan_id"/>
                    <field name="state"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- PIVOT VIEW -->
        <record id="view_petadigi_lalu_lintas_pivot" model="ir.ui.view">
            <field name="name">lalu_lintas.pivot.petadigi</field>
            <field name="model">petadigi.lalu_lintas</field>
            <field name="arch" type="xml">
                <pivot string="Analisis Lalu Lintas" disable_linking="False">
                    <field name="kategori_id" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- CALENDAR VIEW -->
        <record id="view_petadigi_lalu_lintas_calendar" model="ir.ui.view">
            <field name="name">lalu_lintas.calendar.petadigi</field>
            <field name="model">petadigi.lalu_lintas</field>
            <field name="arch" type="xml">
                <calendar string="Kalender Lalu Lintas"
                          date_start="tanggal_kejadian"
                          color="state"
                          mode="month"
                          quick_create="False">
                    <field name="nama_lokasi"/>
                    <field name="kategori_id"/>
                    <field name="kabupaten_id"/>
                    <field name="state" filters="1" invisible="1"/>
                </calendar>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_petadigi_lalu_lintas_form" model="ir.ui.view">
            <field name="name">lalu_lintas.form.petadigi</field>
            <field name="model">petadigi.lalu_lintas</field>
            <field name="arch" type="xml">
                <form string="Data Lalu Lintas">
                    <header>
                        <button name="action_set_selesai" string="Selesai" type="object"
                            class="btn-primary" invisible="state == 'SELESAI'"/>
                        <button name="action_set_proses" string="Kembalikan ke Proses" type="object"
                            class="btn-secondary" invisible="state == 'PROSES'"/>
                        <field name="state" widget="statusbar" statusbar_visible="PROSES,SELESAI"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="code" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="nama_lokasi"/>
                                <field name="tanggal_kejadian"/>
                                <field name="kategori_id"/>
                                <field name="jenis_jalan_id"/>
                                <field name="penanggung_jawab"/>
                                <field name="sumber_dokumen_id"/>
                            </group>
                            <group>
                                
                                <field name="foto" widget="image_popup" nolabel="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="WILAYAH">
                                <field name="kabupaten_id"/>
                                <field name="kecamatan_id" domain="[('kabupaten_id', '=', kabupaten_id)]"/>
                                <field name="desa_id" domain="[('kecamatan_id', '=', kecamatan_id)]"/>
                            </group>
                        </group>

                        <div>
                            <field name="latitude" widget="latlong_map_picker"
                                class="latlong-mappicker-wrapper"
                                nolabel="1"/>
                        </div>

                        <group>
                            <field name="latitude" string="Latitude"/>
                            <field name="longitude" string="Longitude"/>
                        </group>

                        <notebook>
                            <page string="Detail Lalu Lintas">
                                <group>
                                    <field name="penyebab" />
                                    <field name="tindak_lanjut" />
                                    <field name="keterangan" />
                                </group>
                                 
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_petadigi_lalu_lintas" model="ir.actions.act_window">
            <field name="name">Lalu Lintas</field>
            <field name="res_model">petadigi.lalu_lintas</field>
            <field name="view_mode">list,form,graph,pivot,calendar</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list',     'view_id': ref('view_petadigi_lalu_lintas_list')}),
                (0, 0, {'view_mode': 'form',     'view_id': ref('view_petadigi_lalu_lintas_form')}),
                (0, 0, {'view_mode': 'graph',    'view_id': ref('view_petadigi_lalu_lintas_graph')}),
                (0, 0, {'view_mode': 'pivot',    'view_id': ref('view_petadigi_lalu_lintas_pivot')}),
                (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_petadigi_lalu_lintas_calendar')}),
            ]"/>
            <field name="search_view_id" ref="petadigi.view_petadigi_lalu_lintas_search"/>
            <field name="context">{'search_default_filter_tahun_sekarang': 1}</field>
        </record>
    </data>
</odoo>
