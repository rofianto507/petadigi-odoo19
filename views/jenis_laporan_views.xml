<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="view_petadigi_jenis_laporan_list" model="ir.ui.view">
            <field name="name">jenis_laporan.list.petadigi</field>
            <field name="model">petadigi.jenis_laporan</field>
            <field name="arch" type="xml">
                <list string="Jenis Laporan">
                    <field name="nama"/>
                    <field name="keterangan"/>
                    <field name="jumlah_giat" string="Total Giat"/>
                    <field name="state" widget="badge"
                        decoration-muted="state == 'draft'"
                        decoration-success="state == 'aktif'"
                        decoration-danger="state == 'non_aktif'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_petadigi_jenis_laporan_search" model="ir.ui.view">
            <field name="name">jenis_laporan.search.petadigi</field>
            <field name="model">petadigi.jenis_laporan</field>
            <field name="arch" type="xml">
                <search string="Cari Jenis Laporan">
                    <field name="nama"/>
                    <field name="keterangan"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                    <filter string="Aktif" name="filter_aktif" domain="[('state','=','aktif')]"/>
                    <filter string="Non Aktif" name="filter_non_aktif" domain="[('state','=','non_aktif')]"/>
                    <group>
                        <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_petadigi_jenis_laporan_form" model="ir.ui.view">
            <field name="name">jenis_laporan.form.petadigi</field>
            <field name="model">petadigi.jenis_laporan</field>
            <field name="arch" type="xml">
                <form string="Jenis Laporan">
                    <header>
                        <button name="action_set_aktif" string="Aktifkan" type="object"
                            class="btn-success"
                            invisible="state == 'aktif'"/>
                        <button name="action_set_non_aktif" string="Non Aktifkan" type="object"
                            class="btn-danger"
                            invisible="state == 'non_aktif'"/>
                        <button name="action_set_draft" string="Set Draft" type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,aktif,non_aktif"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-list"
                                    type="object" name="action_view_hasil_giat">
                                <field name="jumlah_giat" widget="statinfo" string="Total Giat"/>
                            </button>
                        </div>
                        <!-- URL + QR Section (hanya tampil saat Aktif) -->
                        <div class="row mb-3 p-3 rounded"
                             invisible="state != 'aktif'"
                             style="background:#e8f4fd; border:1.5px solid #aed6f1;">
                            <!-- Kiri: URL + Tombol -->
                            <div class="col-lg-8 col-12 d-flex flex-column gap-2">
                                <div>
                                    <span class="fw-bold" style="color:#1565c0;">
                                        <i class="fa fa-link me-1"/>
                                        URL Form Petugas Lapangan
                                    </span>
                                </div>
                                <field name="public_url" widget="CopyClipboardChar"
                                       readonly="1" nolabel="1"/>
                                <div class="d-flex gap-2 flex-wrap mt-1">
                                    <button name="action_regenerate_token" type="object"
                                            string="Buat Ulang URL"
                                            class="btn btn-sm btn-secondary"
                                            icon="fa-refresh"
                                            confirm="URL lama akan langsung tidak berlaku dan petugas lapangan yang sedang mengakses tidak bisa submit. Lanjutkan buat ulang URL?"
                                            title="Buat token URL baru — link lama tidak berlaku"/>
                                    <button name="action_share_whatsapp" type="object"
                                            string="Share WhatsApp Web"
                                            class="btn btn-sm btn-success"
                                            icon="fa-whatsapp"/>
                                </div>
                            </div>
                            <!-- Kanan: QR Code -->
                            <div class="col-lg-4 col-12 d-flex flex-column align-items-center justify-content-center mt-3 mt-lg-0">
                                <div class="text-muted small mb-1">
                                    <i class="fa fa-qrcode me-1"/>QR Code
                                </div>
                                <field name="qr_code_image" widget="image"
                                       readonly="1" nolabel="1"
                                       options="{'size': [150, 150], 'zoom': False}"/>
                            </div>
                        </div>

                        <group>
                            <group>
                                <field name="nama"/>
                            </group>
                        </group>
                        <group>
                            <field name="keterangan"/>
                        </group>

                        <notebook>
                            <page string="Data Giat" name="data_giat">
                                <field name="hasil_giat_ids" nolabel="1">
                                    <list create="0" edit="0"
                                          default_order="tanggal desc">
                                        <field name="tanggal" string="Tanggal"/>
                                        <field name="code" string="Kode"/>
                                        <field name="pangkat_petugas" string="Pangkat"/>
                                        <field name="nama_petugas" string="Nama Petugas"/>
                                        <field name="nrp" string="NRP"/>
                                        <field name="polres_id" string="Polres"/>
                                        <field name="polsek_id" string="Polsek"/>
                                        <field name="kegiatan" string="Kegiatan"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_petadigi_jenis_laporan" model="ir.actions.act_window">
            <field name="name">Jenis Laporan</field>
            <field name="res_model">petadigi.jenis_laporan</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_petadigi_jenis_laporan_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_petadigi_jenis_laporan_form')}),
            ]"/>
            <field name="search_view_id" ref="petadigi.view_petadigi_jenis_laporan_search"/>
        </record>
    </data>
</odoo>
