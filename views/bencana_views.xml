<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- LIST VIEW -->
        <record id="view_petadigi_bencana_list" model="ir.ui.view">
            <field name="name">bencana.list.petadigi</field>
            <field name="model">petadigi.bencana</field>
            <field name="arch" type="xml">
                <list string="Data Bencana">
                    <field name="code"/>
                    <field name="tahun"/>
                    <field name="nama_bencana"/>
                    <field name="kategori_id"/>
                    <field name="tanggal_kejadian"/>
                    <field name="kabupaten_id"/>
                    <field name="kecamatan_id" optional="hide"/>
                    <field name="desa_id" optional="hide"/>
                    <field name="state" widget="badge"
                        decoration-danger="state == 'AKTIF'"
                        decoration-success="state == 'NON AKTIF'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_petadigi_bencana_search" model="ir.ui.view">
            <field name="name">bencana.search.petadigi</field>
            <field name="model">petadigi.bencana</field>
            <field name="arch" type="xml">
                <search string="Cari Data Bencana">
                    <field name="code"/>
                    <field name="nama_bencana"/>
                    <field name="keterangan"/>
                    <separator/>
                    <filter string="AKTIF" name="filter_aktif" domain="[('state','=','AKTIF')]"/>
                    <filter string="NON AKTIF" name="filter_non_aktif" domain="[('state','=','NON AKTIF')]"/>
                    <separator/>
                    <filter string="Tanggal Kejadian" name="filter_tanggal_kejadian" date="tanggal_kejadian"/>
                    <group>
                        <filter string="Tahun" name="groupby_tahun" context="{'group_by': 'tahun'}"/>
                        <filter string="Kategori" name="groupby_kategori" context="{'group_by': 'kategori_id'}"/>
                        <filter string="Kabupaten" name="groupby_kabupaten" context="{'group_by': 'kabupaten_id'}"/>
                        <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- GRAPH VIEW -->
        <record id="view_petadigi_bencana_graph" model="ir.ui.view">
            <field name="name">bencana.graph.petadigi</field>
            <field name="model">petadigi.bencana</field>
            <field name="arch" type="xml">
                <graph string="Grafik Bencana" type="bar">
                    <field name="tanggal_kejadian" interval="month"/>
                    <field name="kategori_id"/>
                    <field name="state"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_petadigi_bencana_form" model="ir.ui.view">
            <field name="name">bencana.form.petadigi</field>
            <field name="model">petadigi.bencana</field>
            <field name="arch" type="xml">
                <form string="Data Bencana">
                    <header>
                        <button name="action_set_non_aktif" string="Non Aktif" type="object"
                            class="btn-danger" invisible="state == 'NON AKTIF'"/>
                        <button name="action_set_aktif" string="Aktifkan Kembali" type="object"
                            class="btn-secondary" invisible="state == 'AKTIF'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="AKTIF,NON AKTIF"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="code" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="nama_bencana"/>
                                <field name="kategori_id"/>
                                <field name="tanggal_kejadian"/>
                            </group>
                            <group>
                                <field name="sumber_dokumen_id"/>
                                <field name="foto" widget="image_popup" nolabel="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="WILAYAH">
                                <field name="kabupaten_id"/>
                                <field name="kecamatan_id" domain="[('kabupaten_id', '=', kabupaten_id)]"/>
                                <field name="desa_id" domain="[('kecamatan_id', '=', kecamatan_id)]"/>
                            </group>
                        </group>

                        <div>
                            <field name="latitude" widget="latlong_map_picker"
                                class="latlong-mappicker-wrapper"
                                nolabel="1"/>
                        </div>

                        <group>
                            <field name="latitude" string="Latitude"/>
                            <field name="longitude" string="Longitude"/>
                        </group>

                        <notebook>
                            <page string="Detail Bencana">
                                <group >
                                    <field name="penyebab" />
                                    <field name="tindak_lanjut"/>
                                    <field name="keterangan" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_petadigi_bencana" model="ir.actions.act_window">
            <field name="name">Bencana</field>
            <field name="res_model">petadigi.bencana</field>
            <field name="view_mode">list,form,graph</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_petadigi_bencana_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_petadigi_bencana_form')}),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('view_petadigi_bencana_graph')}),
            ]"/>
            <field name="search_view_id" ref="petadigi.view_petadigi_bencana_search"/>
        </record>
    </data>
</odoo>
