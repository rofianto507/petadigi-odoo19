<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

    <!-- ═══════════════════════════════════════════════════════
         MODULE CATEGORY
    ═══════════════════════════════════════════════════════ -->
    <record id="module_category_petadigi" model="ir.module.category">
        <field name="name">PetaDigi</field>
        <field name="sequence">50</field>
    </record>

    <!-- Odoo 19: privilege layer between category and groups -->
    <record id="privilege_petadigi_access" model="res.groups.privilege">
        <field name="name">PetaDigi</field>
        <field name="category_id" ref="module_category_petadigi"/>
        <field name="sequence">10</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         GROUPS
         Hierarki:
           group_petadigi_user  ← base teknikal (implied oleh semua grup)
           group_admin          → implies group_petadigi_user
           group_subdit         → implies group_petadigi_user
           group_polres         → implies group_petadigi_user
           group_polsek         → implies group_petadigi_user
         Satu user hanya boleh berada di SATU grup operasional.
    ═══════════════════════════════════════════════════════ -->

    <!-- Base group: teknikal, tidak muncul di form user -->
    <record id="group_petadigi_user" model="res.groups">
        <field name="name">Pengguna PetaDigi</field>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_petadigi_access"/>
        <field name="implied_ids" eval="[(4, ref('petadigi.group_petadigi_user'))]"/>
    </record>

    <record id="group_subdit" model="res.groups">
        <field name="name">Subdit</field>
        <field name="privilege_id" ref="privilege_petadigi_access"/>
        <field name="implied_ids" eval="[(4, ref('petadigi.group_petadigi_user'))]"/>
    </record>

    <record id="group_polres" model="res.groups">
        <field name="name">Polres</field>
        <field name="privilege_id" ref="privilege_petadigi_access"/>
        <field name="implied_ids" eval="[(4, ref('petadigi.group_petadigi_user'))]"/>
    </record>

    <record id="group_polsek" model="res.groups">
        <field name="name">Polsek</field>
        <field name="privilege_id" ref="privilege_petadigi_access"/>
        <field name="implied_ids" eval="[(4, ref('petadigi.group_petadigi_user'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         RECORD RULES
         Admin tidak butuh record rule (akses global via ir.model.access).
         Polres/Polsek/Subdit difilter via domain user.xxx_id.id.
         Jika field org belum diisi admin → domain '= False' → hanya
         melihat record yang juga tidak punya field tersebut (minimal risk).
    ═══════════════════════════════════════════════════════ -->

    <!-- ─── Polres ─────────────────────────────────────────── -->
    <record id="rule_polres_polres" model="ir.rule">
        <field name="name">Polres: hanya polres sendiri</field>
        <field name="model_id" ref="model_petadigi_polres"/>
        <field name="domain_force">[('id', '=', user.polres_id.id)]</field>
        <field name="groups" eval="[(4, ref('petadigi.group_polres'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

