<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="petadigi.DashboardMap">
        <div class="petadigi-dashboard">

            <!-- ══ SIDEBAR ══ -->
            <div class="petadigi-sidebar" t-ref="sidebar">
                <!-- Collapse button di atas -->
                <div class="petadigi-sidebar-top">
                    <button class="petadigi-collapse-btn" t-on-click="onToggleSidebar">
                        <i class="fa fa-angle-double-left" t-ref="collapseIcon"/>
                        <span t-ref="collapseText"/>
                    </button>
                </div>

                <div class="petadigi-sidebar-section-title">PETA</div>

                <nav class="petadigi-nav">
                    <a class="petadigi-nav-item active" data-mode="umum" t-on-click="onNavClick">
                        <i class="fa fa-map"/>
                        <span>Peta Umum</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="kriminal" t-on-click="onNavClick">
                        <i class="fa fa-exclamation-triangle"/>
                        <span>Peta Kriminalitas</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="kam" t-on-click="onNavClick">
                        <i class="fa fa-shield"/>
                        <span>Peta Kasus Menonjol</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="bencana" t-on-click="onNavClick">
                        <i class="fa fa-bolt"/>
                        <span>Peta Bencana</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="lalin" t-on-click="onNavClick">
                        <i class="fa fa-car"/>
                        <span>Peta Lalu Lintas</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="strong" t-on-click="onNavClick">
                        <i class="fa fa-map-pin"/>
                        <span>Peta Strong Point</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="lokasi" t-on-click="onNavClick">
                        <i class="fa fa-map-marker"/>
                        <span>Lokasi Penting</span>
                    </a>
                    <a class="petadigi-nav-item" data-mode="sumur" t-on-click="onNavClick">
                        <i class="fa fa-tint"/>
                        <span>Sumur Minyak</span>
                    </a>
                </nav>
            </div>

            <!-- ══ MAIN CONTENT ══ -->
            <div class="petadigi-main-content">

                <!-- TOP ROW: breadcrumb + filter -->
                <div class="petadigi-top-row">
                    <div class="petadigi-breadcrumb-box" t-ref="breadcrumb">
                        <i class="fa fa-map"/> Peta Umum
                    </div>
                    <div class="petadigi-filter-box">
                        <i class="fa fa-filter"/>
                        <select class="petadigi-select" t-ref="filterJenisLP" t-on-change="onFilterChange">
                            <option value="">Semua Jenis LP</option>
                            <option value="LP A">LP A</option>
                            <option value="LP B">LP B</option>
                        </select>
                        <select class="petadigi-select" t-ref="filterKategori" t-on-change="onKategoriChange">
                            <option value="">Semua Kategori</option>
                        </select>
                        <select class="petadigi-select" t-ref="filterSubKategori" t-on-change="onFilterChange">
                            <option value="">Semua Sub Kategori</option>
                        </select>
                        <select class="petadigi-select" t-ref="filterTahun" t-on-change="onFilterChange">
                            <option value="">Semua Tahun</option>
                        </select>
                        <select class="petadigi-select" t-ref="filterPolres" t-on-change="onFilterChange">
                            <option value="">Semua Polres</option>
                        </select>
                        <select class="petadigi-select" t-ref="filterKategoriSumur" t-on-change="onFilterChange">
                            <option value="">Semua Kategori</option>
                        </select>
                        <select class="petadigi-select" t-ref="filterState" t-on-change="onFilterChange">
                            <option value="">Semua Status</option>
                        </select>
                        <div class="petadigi-date-range" t-ref="filterDateRangeWrapper">
                            <i class="fa fa-calendar"/>
                            <input type="text" class="petadigi-flatpickr-input" t-ref="filterDateRange"
                                placeholder="Pilih Rentang Tanggal" readonly="true"/>
                            <button class="petadigi-date-clear" t-ref="filterDateClear"
                                t-on-click="onClearDate" title="Reset Tanggal">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Filter aktif summary + sumber dokumen info -->
                <div class="petadigi-summary-row">
                    <div class="petadigi-filter-summary" t-ref="filterSummary"/>
                    <div class="petadigi-sumber-info" t-ref="sumberInfo"/>
                </div>

                <!-- KPI ROW — diisi oleh JS sesuai mode aktif -->
                <div class="petadigi-kpi-row" t-ref="kpiRow"/>

                <!-- MAP -->
                <div class="petadigi-map-wrapper" t-ref="mapWrapper">
                    <div t-ref="mapContainer" class="petadigi-map-container" tabindex="-1"/>
                </div>

                <!-- CHART KAM ROW 1 — hanya untuk mode kam -->
                <div class="petadigi-chart-row" t-ref="chartKamRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Kasus Menonjol per Kabupaten
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartKamBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title" t-ref="chartKamDonutTitle">
                            <i class="fa fa-pie-chart"/> Kasus Menonjol Berdasarkan Kategori (Semua Wilayah)
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartKamDonut"/>
                    </div>
                </div>

                <!-- CHART KAM ROW 2 — modus operandi + jenis TKP -->
                <div class="petadigi-chart-row" t-ref="chartKamRow2">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-random"/> Kasus Menonjol per Modus Operandi
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartKamModus"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-map-pin"/> Kasus Menonjol per Lokasi Kejadian
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartKamTkp"/>
                    </div>
                </div>

                <!-- CHART KAM ROW 3 — data tahunan -->
                <div class="petadigi-chart-row" t-ref="chartKamRow3">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-line-chart"/> Data Tahunan Kasus Menonjol
                        </div>
                        <div class="petadigi-chart-body petadigi-chart-body--tall" t-ref="chartKamTahunan"/>
                    </div>
                </div>

                <!-- CHART BENCANA ROW — hanya untuk mode bencana -->
                <div class="petadigi-chart-row" t-ref="chartBencanaRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Bencana per Kabupaten
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartBencanaBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title" t-ref="chartBencanaDonutTitle">
                            <i class="fa fa-pie-chart"/> Bencana Berdasarkan Kategori (Semua Wilayah)
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartBencanaDonut"/>
                    </div>
                </div>

                <!-- CHART LALIN ROW — hanya untuk mode lalin -->
                <div class="petadigi-chart-row" t-ref="chartLalinRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Lalu Lintas per Kabupaten
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartLalinBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title" t-ref="chartLalinDonutTitle">
                            <i class="fa fa-pie-chart"/> Lalu Lintas Berdasarkan Kategori (Semua Wilayah)
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartLalinDonut"/>
                    </div>
                </div>

                <!-- CHART LALIN ROW 2 — jenis jalan + waktu kejadian -->
                <div class="petadigi-chart-row" t-ref="chartLalinRow2">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-road"/> Lalu Lintas per Jenis Jalan
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartLalinJenisJalan"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-clock-o"/> Rentang Waktu Kejadian Lalu Lintas
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartLalinWaktu"/>
                    </div>
                </div>

                <!-- CHART STRONG ROW — hanya untuk mode strong -->
                <div class="petadigi-chart-row" t-ref="chartStrongRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Strong Point per Polres
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartStrongBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-line-chart"/> Strong Point per Bulan
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartStrongTrend"/>
                    </div>
                </div>

                <!-- CHART LOKASI ROW — hanya untuk mode lokasi -->
                <div class="petadigi-chart-row" t-ref="chartLokasiRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Lokasi Penting per Kabupaten
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartLokasiBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title" t-ref="chartLokasiDonutTitle">
                            <i class="fa fa-pie-chart"/> Lokasi Penting Berdasarkan Kategori (Semua Wilayah)
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartLokasiDonut"/>
                    </div>
                </div>

                <!-- CHART SUMUR ROW — hanya untuk mode sumur -->
                <div class="petadigi-chart-row" t-ref="chartSumurRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Sumur Minyak per Kabupaten
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartSumurBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-pie-chart"/> Kategori Sumur Minyak
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartSumurDonut"/>
                    </div>
                </div>

                <!-- CHART ROW 1 — di bawah map, hanya untuk mode kriminal -->
                <div class="petadigi-chart-row" t-ref="chartRow">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-bar-chart"/> Grafik Total Kriminalitas per Kabupaten
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartBar"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title" t-ref="chartDonutTitle">
                            <i class="fa fa-pie-chart"/> Grafik Kriminalitas Berdasarkan Kategori (Semua Wilayah)
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartDonut"/>
                    </div>
                </div>

                <!-- CHART ROW 2 — lokasi kejahatan + sub kategori -->
                <div class="petadigi-chart-row" t-ref="chartRow2">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-map-pin"/> Lokasi Kejahatan Terbanyak
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartTkp"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-tags"/> Sub Kategori Kejahatan Terbanyak
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartSubKat"/>
                    </div>
                </div>

                <!-- CHART ROW 3 — trend bulanan (2/3) + statistik waktu (1/3) -->
                <div class="petadigi-chart-row" t-ref="chartRow3">
                    <div class="petadigi-chart-card petadigi-chart-card--wide">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-line-chart"/> Trend Kriminalitas
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartTrend"/>
                    </div>
                    <div class="petadigi-chart-card petadigi-chart-card--narrow">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-clock-o"/> Statistik Waktu Kriminalitas
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartWaktu"/>
                    </div>
                </div>

                <!-- CHART ROW 5 — data tahunan perbandingan dua tahun, full lebar -->
                <div class="petadigi-chart-row" t-ref="chartRow5">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-line-chart"/> Data Tahunan
                        </div>
                        <div class="petadigi-chart-body petadigi-chart-body--tall" t-ref="chartTahunan"/>
                    </div>
                </div>

                <!-- CHART ROW 4 — waktu kejadian per sub kategori (Curat, Curas, Curanmor) -->
                <div class="petadigi-chart-row" t-ref="chartRow4">
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-clock-o"/> Waktu Kejadian Curat
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartCurat"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-clock-o"/> Waktu Kejadian Curas
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartCuras"/>
                    </div>
                    <div class="petadigi-chart-card">
                        <div class="petadigi-chart-title">
                            <i class="fa fa-clock-o"/> Waktu Kejadian Curanmor
                        </div>
                        <div class="petadigi-chart-body" t-ref="chartCuranmor"/>
                    </div>
                </div>

                <!-- DATA TABLE KRIMINALITAS -->
                <div class="petadigi-chart-row" t-ref="tableKriminalRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Kriminalitas</div>
                        <div t-ref="tableKriminalBody"/>
                    </div>
                </div>

                <!-- DATA TABLE KASUS MENONJOL -->
                <div class="petadigi-chart-row" t-ref="tableKamRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Kasus Menonjol</div>
                        <div t-ref="tableKamBody"/>
                    </div>
                </div>

                <!-- DATA TABLE BENCANA -->
                <div class="petadigi-chart-row" t-ref="tableBencanaRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Bencana</div>
                        <div t-ref="tableBencanaBody"/>
                    </div>
                </div>

                <!-- DATA TABLE LALU LINTAS -->
                <div class="petadigi-chart-row" t-ref="tableLalinRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Lalu Lintas</div>
                        <div t-ref="tableLalinBody"/>
                    </div>
                </div>

                <!-- DATA TABLE STRONG POINT -->
                <div class="petadigi-chart-row" t-ref="tableStrongRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Strong Point</div>
                        <div t-ref="tableStrongBody"/>
                    </div>
                </div>

                <!-- DATA TABLE LOKASI PENTING -->
                <div class="petadigi-chart-row" t-ref="tableLokasiRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Lokasi Penting</div>
                        <div t-ref="tableLokasiBody"/>
                    </div>
                </div>

                <!-- DATA TABLE SUMUR MINYAK -->
                <div class="petadigi-chart-row" t-ref="tableSumurRow">
                    <div class="petadigi-data-table-card">
                        <div class="petadigi-chart-title"><i class="fa fa-table"/> Data Sumur Minyak</div>
                        <div t-ref="tableSumurBody"/>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
