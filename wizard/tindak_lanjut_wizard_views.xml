<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tindak_lanjut_wizard_form" model="ir.ui.view">
            <field name="name">tindak_lanjut.wizard.form</field>
            <field name="model">petadigi.tindak_lanjut.wizard</field>
            <field name="arch" type="xml">
                <form string="Tambah Tindak Lanjut">
                    <field name="kasus_menonjol_id" invisible="1"/>
                    <group>
                        <field name="tanggal"/>
                        <field name="tindakan" placeholder="Uraikan tindakan yang dilakukan..."/>
                        <field name="attachment" filename="attachment_filename" widget="binary"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Simpan" type="object" class="btn-primary"/>
                        <button string="Batal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
