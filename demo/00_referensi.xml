            <field name="tipe_sumber">KASUS MENONJOL</field>
            <field name="tahun">2025</field>
        </record>
        <record id="demo_sdok_bcn_2025" model="petadigi.sumber_dokumen">
            <field name="name">Laporan Bencana 2025</field>
            <field name="tipe_sumber">BENCANA</field>
            <field name="tahun">2025</field>
        </record>
