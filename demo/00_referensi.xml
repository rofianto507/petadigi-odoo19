<?xml version="1.0" encoding="utf-8"?>
<!--
    Demo Data — Data Referensi Master
    Mencakup: Subdit, Sumber Dokumen, semua Kategori, Jenis Jalan,
              Modus Operandi, Jenis TKP, Sub Status Perkara.
-->
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════
             SUBDIT
        ═══════════════════════════════════════════════════ -->
        <record id="demo_subdit_krimsus" model="petadigi.subdit">
            <field name="name">Subdit I — Krimsus</field>
            <field name="keterangan">Subdirektorat Tindak Pidana Khusus</field>
        </record>
        <record id="demo_subdit_krimum" model="petadigi.subdit">
            <field name="name">Subdit II — Krimum</field>
            <field name="keterangan">Subdirektorat Tindak Pidana Umum</field>
        </record>
        <record id="demo_subdit_kamtibmas" model="petadigi.subdit">
            <field name="name">Subdit III — Kamtibmas</field>
            <field name="keterangan">Subdirektorat Keamanan dan Ketertiban Masyarakat</field>
        </record>

