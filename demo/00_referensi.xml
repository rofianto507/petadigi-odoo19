            <field name="icon">fa-car</field>
        </record>
        <record id="demo_kat_krim_curat" model="petadigi.kategori_kriminal">
            <field name="name">Curas / Curat</field>
            <field name="icon">fa-home</field>
        </record>
        <record id="demo_kat_krim_narkoba" model="petadigi.kategori_kriminal">
            <field name="name">Narkoba</field>
            <field name="icon">fa-exclamation-triangle</field>
        </record>
        <record id="demo_kat_krim_penganiayaan" model="petadigi.kategori_kriminal">
            <field name="name">Penganiayaan</field>
            <field name="icon">fa-male</field>
        </record>

        <record id="demo_sub_kat_curanmor_motor" model="petadigi.sub_kategori_kriminal">
            <field name="name">Sepeda Motor</field>
            <field name="kategori_kriminal_id" ref="demo_kat_krim_curanmor"/>
        </record>
        <record id="demo_sub_kat_curanmor_mobil" model="petadigi.sub_kategori_kriminal">
