             SUMBER DOKUMEN
        ═══════════════════════════════════════════════════ -->
        <record id="demo_sdok_krim_2025" model="petadigi.sumber_dokumen">
            <field name="name">LP Kriminalitas 2025</field>
            <field name="tipe_sumber">KRIMINALITAS</field>
            <field name="tahun">2025</field>
        </record>
        <record id="demo_sdok_krim_2024" model="petadigi.sumber_dokumen">
            <field name="name">LP Kriminalitas 2024</field>
            <field name="tipe_sumber">KRIMINALITAS</field>
            <field name="tahun">2024</field>
        </record>
        <record id="demo_sdok_kam_2025" model="petadigi.sumber_dokumen">
